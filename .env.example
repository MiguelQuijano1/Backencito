# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=America/Lima
RATE_LIMIT_PER_MINUTE=120

# ── Supabase (Data API) ─────────────────────────────────────
SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AWS (opcional; por defecto off) ─────────────────────────
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_REGIONS=us-east-1,us-west-2,sa-east-1,eu-west-1,eu-central-1,ap-southeast-1
ENABLE_COST_EXPLORER=false
COST_BASIS=month_to_date

# ── Auth del panel (opcional) ───────────────────────────────
AUTH_ENABLED=false
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Geo (Nominatim) ─────────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Backencito/1.0 (proyecto escolar CloudOps)
